{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "砚台",
  "version": "0.1.0",
  "identifier": "com.inkstone.research",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "砚台 · Research Desk",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "dragDropEnabled": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false
  }
}
