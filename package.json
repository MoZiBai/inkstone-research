{
  "name": "inkstone-research",
  "version": "0.1.0",
  "private": true,
  "description": "砚台：面向深度阅读、资料摘录与想法整理的本地卡片工作台",
  "type": "module",
  "scripts": {
    "setup:rust": "pwsh -NoProfile -File scripts/bootstrap-rust.ps1",
    "dev": "pwsh -NoProfile -File scripts/tauri.ps1 dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "pnpm run typecheck && pwsh -NoProfile -File scripts/tauri.ps1 build",
    "build:web": "vite build",
    "check:rust": "pwsh -NoProfile -File scripts/cargo.ps1 check --manifest-path src-tauri/Cargo.toml",
    "format:rust": "pwsh -NoProfile -File scripts/cargo.ps1 fmt --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "pwsh -NoProfile -File scripts/cargo.ps1 clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "pwsh -NoProfile -File scripts/cargo.ps1 test --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
